<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <!-- 顶部：标题 + 历史/设置 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textSize="27sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:letterSpacing="0.02" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_subtitle"
                    android:textSize="12sp"
                    android:textColor="@color/text_hint"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <Button
                android:id="@+id/historyBtn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:background="@drawable/bg_glass_card"
                android:elevation="2dp"
                android:text="🕘"
                android:textSize="18sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginEnd="10dp" />
            <Button
                android:id="@+id/settingsBtn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:background="@drawable/bg_glass_card"
                android:elevation="2dp"
                android:text="⚙️"
                android:textSize="20sp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
        </LinearLayout>
        <!-- 方向胶囊（点击切换方向） -->
        <TextView
            android:id="@+id/dirLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_chip"
            android:elevation="3dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:gravity="center"
            android:text="@string/auto_recognize"
            android:textSize="13sp"
            android:textColor="@color/accent_purple"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="翻译方向：点击切换 自动 / 中文转老挝语 / 老挝语转中文"
            android:layout_marginTop="16dp" />
        <!-- 输入区 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top"
            android:layout_marginTop="14dp">
            <EditText
                android:id="@+id/inputText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="120dp"
                android:gravity="top|start"
                android:background="@drawable/bg_glass_input"
                android:elevation="2dp"
                android:padding="16dp"
                android:hint="@string/hint_input"
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:inputType="textMultiLine"
                android:minLines="4" />
            <Button
                android:id="@+id/clearBtn"
                android:layout_width="52dp"
                android:layout_height="120dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_glass_card"
                android:elevation="2dp"
                android:text="@string/clear_btn"
                android:textSize="18sp"
                android:textColor="@color/text_hint"
                android:contentDescription="@string/clear_cd" />
        </LinearLayout>
        <!-- 语音：国旗卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp">
            <Button
                android:id="@+id/voiceZhBtn"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:background="@drawable/bg_glass_card"
                android:elevation="2dp"
                android:text="@string/voice_zh"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:contentDescription="@string/cd_voice_zh"
                android:layout_marginEnd="10dp" />
            <Button
                android:id="@+id/voiceLaBtn"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                android:background="@drawable/bg_glass_card"
                android:elevation="2dp"
                android:text="@string/voice_lo"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:contentDescription="@string/cd_voice_la" />
        </LinearLayout>
        <!-- 翻译 / 互换 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp">
            <Button
                android:id="@+id/translateBtn"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1.7"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:background="@drawable/bg_glass_primary"
                android:elevation="8dp"
                android:text="@string/btn_translate"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:letterSpacing="0.1"
                android:layout_marginEnd="10dp" />
            <Button
                android:id="@+id/swapBtn"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:background="@drawable/bg_glass_secondary"
                android:elevation="4dp"
                android:text="@string/btn_swap"
                android:textSize="15sp"
                android:textColor="@color/text_primary" />
        </LinearLayout>
        <!-- 结果卡片 -->
        <TextView
            android:id="@+id/resultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="130dp"
            android:gravity="top|start"
            android:background="@drawable/bg_glass_card"
            android:elevation="4dp"
            android:padding="16dp"
            android:textSize="18sp"
            android:textColor="@color/text_primary"
            android:lineSpacingExtra="4dp"
            android:text=""
            android:layout_marginTop="16dp" />
        <Button
            android:id="@+id/speakBtn"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:background="@drawable/bg_glass_secondary"
            android:elevation="4dp"
            android:text="@string/btn_speak"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:layout_marginTop="14dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="14dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/speed_label"
                android:textSize="12sp"
                android:textColor="@color/text_hint" />
            <RadioGroup
                android:id="@+id/speedGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_glass_pill"
                android:elevation="2dp"
                android:padding="4dp"
                android:layout_marginTop="6dp">
                <RadioButton
                    android:id="@+id/speed075"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:button="@null"
                    android:background="@drawable/bg_radio_seg"
                    android:gravity="center"
                    android:text="0.75"
                    android:textSize="12sp"
                    android:textColor="@color/text_seg_selector" />
                <RadioButton
                    android:id="@+id/speed100"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:button="@null"
                    android:background="@drawable/bg_radio_seg"
                    android:gravity="center"
                    android:text="1.0"
                    android:textSize="12sp"
                    android:textColor="@color/text_seg_selector"
                    android:checked="true" />
                <RadioButton
                    android:id="@+id/speed125"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:button="@null"
                    android:background="@drawable/bg_radio_seg"
                    android:gravity="center"
                    android:text="1.25"
                    android:textSize="12sp"
                    android:textColor="@color/text_seg_selector" />
                <RadioButton
                    android:id="@+id/speed150"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:button="@null"
                    android:background="@drawable/bg_radio_seg"
                    android:gravity="center"
                    android:text="1.5"
                    android:textSize="12sp"
                    android:textColor="@color/text_seg_selector" />
                <RadioButton
                    android:id="@+id/speed200"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:button="@null"
                    android:background="@drawable/bg_radio_seg"
                    android:gravity="center"
                    android:text="2.0"
                    android:textSize="12sp"
                    android:textColor="@color/text_seg_selector" />
            </RadioGroup>
        </LinearLayout>
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/text_hint"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>
