<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F5F5FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="老挝语 ↔ 中文 翻译"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#333333"/>

        <Button
            android:id="@+id/settingsBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙️ 设置"/>
    </LinearLayout>

    <TextView
        android:id="@+id/dirLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="中文 → 老挝语"
        android:textSize="14sp"
        android:textColor="#6650a4"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/inputText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="120dp"
        android:gravity="top|start"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:hint="输入要翻译的文字…"
        android:inputType="textMultiLine"
        android:minLines="4"
        android:textSize="16sp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/voiceBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🎤 语音输入"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/translateBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="翻译"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/swapBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⇄ 互换"/>
    </LinearLayout>

    <TextView
        android:id="@+id/resultText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="100dp"
        android:gravity="top|start"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:textSize="18sp"
        android:textColor="#222222"
        android:text=""
        android:layout_marginTop="12dp"/>

    <Button
        android:id="@+id/speakBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔊 朗读"
        android:layout_marginTop="12dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="语速"
            android:textSize="13sp"
            android:textColor="#6650a4"/>

        <RadioGroup
            android:id="@+id/speedGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="8dp">

            <RadioButton
                android:id="@+id/speed075"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.75"
                android:textSize="13sp"/>
            <RadioButton
                android:id="@+id/speed100"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.0"
                android:textSize="13sp"
                android:checked="true"/>
            <RadioButton
                android:id="@+id/speed125"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.25"
                android:textSize="13sp"/>
            <RadioButton
                android:id="@+id/speed150"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.5"
                android:textSize="13sp"/>
            <RadioButton
                android:id="@+id/speed200"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2.0"
                android:textSize="13sp"/>
        </RadioGroup>
    </LinearLayout>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#888888"
        android:layout_marginTop="8dp"/>

</LinearLayout>
