<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_dialog"
    android:padding="22dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_base_url"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/baseUrlEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://api.b.ai/v1"
            android:textColorHint="@color/text_hint"
            android:textColor="@color/text_primary"
            android:inputType="textUri"
            android:textSize="14sp"
            android:background="@drawable/bg_glass_input"
            android:padding="12dp"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_api_key"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/apiKeyEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="sk-..."
            android:textColorHint="@color/text_hint"
            android:textColor="@color/text_primary"
            android:inputType="textPassword"
            android:textSize="14sp"
            android:background="@drawable/bg_glass_input"
            android:padding="12dp"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_model"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <EditText
                android:id="@+id/modelEdit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="gpt-4o-mini"
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:inputType="text"
                android:textSize="14sp"
                android:background="@drawable/bg_glass_input"
                android:padding="12dp" />

            <Button
                android:id="@+id/fetchModelsBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_glass_secondary"
                android:text="@string/settings_fetch"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/fetchStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/text_hint"
            android:layout_marginTop="6dp" />

        <!-- 界面语言：中文 / 老挝文 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lang_label"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="18dp" />

        <RadioGroup
            android:id="@+id/langGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_glass_pill"
            android:padding="4dp"
            android:layout_marginTop="4dp">

            <RadioButton
                android:id="@+id/langZh"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:button="@null"
                android:background="@drawable/bg_radio_seg"
                android:gravity="center"
                android:text="@string/label_zh"
                android:textSize="14sp"
                android:textColor="@color/text_seg_selector" />

            <RadioButton
                android:id="@+id/langLo"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:button="@null"
                android:background="@drawable/bg_radio_seg"
                android:gravity="center"
                android:text="@string/label_lo"
                android:textSize="14sp"
                android:textColor="@color/text_seg_selector" />
        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/cancelBtn"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:background="@drawable/bg_glass_secondary"
                android:text="@string/settings_cancel"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/saveBtn"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:background="@drawable/bg_glass_primary"
                android:text="@string/settings_save"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
