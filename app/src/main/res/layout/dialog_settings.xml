<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="接口地址 (Base URL)"
            android:textSize="14sp"
            android:textColor="#555555"/>

        <EditText
            android:id="@+id/baseUrlEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://api.b.ai/v1"
            android:inputType="textUri"
            android:textSize="14sp"
            android:background="#F0F0F5"
            android:padding="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="API Key"
            android:textSize="14sp"
            android:textColor="#555555"
            android:layout_marginTop="12dp"/>

        <EditText
            android:id="@+id/apiKeyEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="sk-..."
            android:inputType="textPassword"
            android:textSize="14sp"
            android:background="#F0F0F5"
            android:padding="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="模型 (Model)"
            android:textSize="14sp"
            android:textColor="#555555"
            android:layout_marginTop="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/modelEdit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="gpt-4o-mini"
                android:inputType="text"
                android:textSize="14sp"
                android:background="#F0F0F5"
                android:padding="10dp"/>

            <Button
                android:id="@+id/fetchModelsBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="拉取模型"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/fetchStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginTop="6dp"/>

    </LinearLayout>
</ScrollView>
