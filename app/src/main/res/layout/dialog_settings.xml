<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_dialog"
    android:padding="22dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙️ 大模型设置"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="接口地址 (Base URL)"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/baseUrlEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://api.b.ai/v1"
            android:textColorHint="@color/text_hint"
            android:textColor="@color/text_primary"
            android:inputType="textUri"
            android:textSize="14sp"
            android:background="@drawable/bg_glass_input"
            android:padding="12dp"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="API Key"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/apiKeyEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="sk-..."
            android:textColorHint="@color/text_hint"
            android:textColor="@color/text_primary"
            android:inputType="textPassword"
            android:textSize="14sp"
            android:background="@drawable/bg_glass_input"
            android:padding="12dp"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="模型 (Model)"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <EditText
                android:id="@+id/modelEdit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="gpt-4o-mini"
                android:textColorHint="@color/text_hint"
                android:textColor="@color/text_primary"
                android:inputType="text"
                android:textSize="14sp"
                android:background="@drawable/bg_glass_input"
                android:padding="12dp" />

            <Button
                android:id="@+id/fetchModelsBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_glass_secondary"
                android:text="拉取模型"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/fetchStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/text_hint"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎙️ 老挝语语音识别 (Google Cloud STT)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="18dp" />

        <EditText
            android:id="@+id/googleSttKeyEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="填写 Google Cloud STT API Key 以识别老挝语语音"
            android:textColorHint="@color/text_hint"
            android:textColor="@color/text_primary"
            android:inputType="textPassword"
            android:textSize="13sp"
            android:background="@drawable/bg_glass_input"
            android:padding="12dp"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="免费额度 60 分钟/月，开通：console.cloud.google.com"
            android:textSize="11sp"
            android:textColor="@color/text_hint"
            android:layout_marginTop="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/cancelBtn"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:background="@drawable/bg_glass_secondary"
                android:text="取消"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/saveBtn"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:background="@drawable/bg_glass_primary"
                android:text="保存"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>